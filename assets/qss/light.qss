* ============================================================================
 *  CYBERPUNK NEON GREEN LIGHT (MATRIX DAYLIGHT)
 *  Modern Cyberpunk Qt Style Sheet (QSS)
 *  Designed for Qt 5 & Qt 6 | Full Widget & Pseudo-State Coverage
 *  Font: Bahnschrift SemiBold / Bahnschrift
 * ============================================================================ */

/* --- Clean Safe Global Font Defaults --- */
* {
    font-family: "Bahnschrift SemiBold", "Bahnschrift", "Segoe UI", sans-serif;
    outline: none;
}

/* ============================================================================
 *  MAIN WINDOW & BASE CONTAINERS
 * ============================================================================ */
QMainWindow {
    background-color: #E8F5E9;
    color: #1B5E20;
}

QMainWindow::separator {
    background-color: #C8E6C9;
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background-color: #00C853;
}

QDialog, QMessageBox {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 1px solid #C8E6C9;
    border-radius: 12px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ============================================================================
 *  FRAMES & GROUP BOXES
 * ============================================================================ */
QFrame {
    background-color: transparent;
    border: none;
}

/* Standard Cyberpunk Styled Panel Frame */
QFrame[frameShape="1"], /* Box */
QFrame[frameShape="2"], /* Panel */
QFrame[frameShape="3"]  /* StyledPanel */ {
    background-color: #F1F8E9;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
}

/* Dividers / Lines */
QFrame[frameShape="4"] /* HLine */ {
    background-color: #C8E6C9;
    border: none;
    max-height: 1px;
    min-height: 1px;
    margin: 4px 0px;
}

QFrame[frameShape="5"] /* VLine */ {
    background-color: #C8E6C9;
    border: none;
    max-width: 1px;
    min-width: 1px;
    margin: 0px 4px;
}

QGroupBox {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    font: 600 12pt "Bahnschrift SemiBold";
    margin-top: 24px;
    padding-top: 18px;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
}

QGroupBox:hover {
    border: 2px solid #00C853;
}

QGroupBox:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0px 8px;
    background-color: #F1F8E9;
    color: #1B5E20;
    font: 600 12pt "Bahnschrift SemiBold";
    border-radius: 6px;
}

QGroupBox::indicator {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    border: 2px solid #C8E6C9;
    border-radius: 4px;
    background-color: #F1F8E9;
}

QGroupBox::indicator:hover {
    border: 2px solid #00C853;
}

QGroupBox::indicator:checked {
    background-color: #00C853;
    border: 2px solid #00C853;
}

/* ============================================================================
 *  LABELS & STATUS BAR
 * ============================================================================ */
QLabel {
    background-color: transparent;
    color: #1B5E20;
    font: 600 12pt "Bahnschrift SemiBold";
    padding: 2px;
}

QLabel:disabled {
    color: #A5C8A5;
}

QLCDNumber {
    background-color: transparent;
    color: #1B5E20;
    font: 600 12pt "Bahnschrift SemiBold";
    padding: 2px;
}

QLCDNumber:disabled {
    color: #A5C8A5;
}

QStatusBar {
    background-color: #F1F8E9;
    color: #1B5E20;
    font: 600 10pt "Bahnschrift SemiBold";
    border-top: 1px solid #C8E6C9;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
    padding: 2px 8px;
}

/* ============================================================================
 *  BUTTONS & INTERACTIVE CONTROLS
 * ============================================================================ */
QPushButton {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    padding: 6px 18px;
    font: 600 12pt "Bahnschrift SemiBold";
    min-height: 24px;
}

QPushButton:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QPushButton:pressed {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 2px solid #00A040;
}

QPushButton:checked {
    background-color: #B9F6CA;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QPushButton:checked:hover {
    background-color: #DCEDC8;
    border: 2px solid #00C853;
}

QPushButton:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QPushButton:default {
    border: 2px solid #00C853;
}

QToolButton {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    padding: 5px;
    font: 600 12pt "Bahnschrift SemiBold";
    min-height: 24px;
}

QToolButton:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QToolButton:pressed {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 2px solid #00A040;
}

QToolButton:checked {
    background-color: #B9F6CA;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QToolButton:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QToolButton::menu-indicator {
    image: url(:/icons/asagiOk.png);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
    top: 1px;
    width: 10px;
    height: 10px;
}

/* ============================================================================
 *  RADIO BUTTON & CHECKBOX
 * ============================================================================ */
QRadioButton {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    font: 600 12pt "Bahnschrift SemiBold";
    padding: 6px 12px 6px 10px;
    spacing: 8px;
}

QRadioButton:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QRadioButton:pressed {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 2px solid #00A040;
}

QRadioButton:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border-radius: 7px;
    border: 2px solid #C8E6C9;
    background-color: #F1F8E9;
}

QRadioButton::indicator:hover {
    border: 2px solid #00C853;
}

QRadioButton::indicator:checked {
    background-color: #00C853;
    border: 2px solid #00C853;
}

QRadioButton::indicator:disabled {
    background-color: #EEF4EE;
    border: 2px solid #D8EAD8;
}

QCheckBox {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    font: 600 12pt "Bahnschrift SemiBold";
    padding: 6px 12px 6px 10px;
    spacing: 8px;
}

QCheckBox:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QCheckBox:pressed {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 2px solid #00A040;
}

QCheckBox:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    border: 2px solid #C8E6C9;
    background-color: #F1F8E9;
}

QCheckBox::indicator:hover {
    border: 2px solid #00C853;
}

QCheckBox::indicator:checked {
    background-color: #00C853;
    border: 2px solid #00C853;
}

QCheckBox::indicator:indeterminate {
    background-color: #00A040;
    border: 2px solid #00C853;
}

QCheckBox::indicator:disabled {
    background-color: #EEF4EE;
    border: 2px solid #D8EAD8;
}

/* ============================================================================
 *  TEXT INPUTS (LINE EDIT, TEXT EDIT, SPINBOX)
 * ============================================================================ */
QLineEdit {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    padding: 6px 10px;
    font: 600 12pt "Bahnschrift SemiBold";
    selection-background-color: #B9F6CA;
    selection-color: #1B5E20;
}

QLineEdit:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QLineEdit:focus {
    background-color: #F1F8E9;
    border: 2px solid #00A040;
}

QLineEdit:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QTextEdit, QPlainTextEdit {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    padding: 8px;
    font: 600 11pt "Bahnschrift SemiBold";
    selection-background-color: #B9F6CA;
    selection-color: #1B5E20;
}

QTextEdit:hover, QPlainTextEdit:hover {
    border: 2px solid #00C853;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #00A040;
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

/* SpinBoxes */
QSpinBox, QDoubleSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 10px;
    padding: 6px 32px 6px 10px;
    font: 600 11pt "Bahnschrift SemiBold";
    selection-background-color: #B9F6CA;
    selection-color: #1B5E20;
}

QSpinBox:hover, QDoubleSpinBox:hover, QTimeEdit:hover, QDateEdit:hover, QDateTimeEdit:hover {
    background-color: #DCEDC8;
    border: 2px solid #00C853;
    color: #1B5E20;
}

QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border: 2px solid #00A040;
}

QSpinBox:disabled, QDoubleSpinBox:disabled, QTimeEdit:disabled, QDateEdit:disabled, QDateTimeEdit:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QSpinBox::up-button, QDoubleSpinBox::up-button, QTimeEdit::up-button, QDateEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    background-color: #DCEDC8;
    border: none;
    border-left: 1px solid #C8E6C9;
    border-top-right-radius: 8px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button, QTimeEdit::down-button, QDateEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    background-color: #DCEDC8;
    border: none;
    border-left: 1px solid #C8E6C9;
    border-bottom-right-radius: 8px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QTimeEdit::up-button:hover, QDateEdit::up-button:hover, QDateTimeEdit::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover, QTimeEdit::down-button:hover, QDateEdit::down-button:hover, QDateTimeEdit::down-button:hover {
    background-color: #C8E6C9;
    border-left: 1px solid #00C853;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed, QTimeEdit::up-button:pressed, QDateEdit::up-button:pressed, QDateTimeEdit::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed, QTimeEdit::down-button:pressed, QDateEdit::down-button:pressed, QDateTimeEdit::down-button:pressed {
    background-color: #B9F6CA;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QTimeEdit::up-arrow, QDateEdit::up-arrow, QDateTimeEdit::up-arrow {
    image: url(:/icons/yukariOk.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QTimeEdit::down-arrow, QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: url(:/icons/asagiOk.png);
    width: 10px;
    height: 10px;
}

/* ============================================================================
 *  COMBO BOX & POPUPS
 * ============================================================================ */
QComboBox {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 10px;
    padding: 6px 36px 6px 12px;
    font: 600 11pt "Bahnschrift SemiBold";
    selection-background-color: #B9F6CA;
    selection-color: #1B5E20;
}

QComboBox:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 2px solid #00C853;
}

QComboBox:focus {
    border: 2px solid #00A040;
}

QComboBox:on {
    border: 2px solid #00C853;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    background-color: #DCEDC8;
    border-left: 1px solid #C8E6C9;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::drop-down:hover {
    background-color: #C8E6C9;
    border-left: 1px solid #00C853;
}

QComboBox::down-arrow {
    image: url(:/icons/asagiOk.png);
    width: 12px;
    height: 12px;
}

/* Pop-up view of QComboBox */
QComboBox QAbstractItemView {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #00C853;
    border-radius: 8px;
    selection-background-color: #B9F6CA;
    selection-color: #1B5E20;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 6px;
    color: #1B5E20;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #B9F6CA;
    color: #1B5E20;
    border: 1px solid #00C853;
}

/* ============================================================================
 *  ITEM VIEWS (LIST, TREE, TABLE, HEADER)
 * ============================================================================ */
QListView, QTreeView, QTableView {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    font: 600 11pt "Bahnschrift SemiBold";
    padding: 6px;
    outline: none;
    show-decoration-selected: 1;
    alternate-background-color: #EAF4EA;
    gridline-color: #C8E6C9;
}

QListView:hover, QTreeView:hover, QTableView:hover {
    border: 2px solid #00C853;
}

QListView:disabled, QTreeView:disabled, QTableView:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QListView::item, QTreeView::item, QTableView::item {
    background-color: transparent;
    color: #1B5E20;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 6px;
    margin: 2px;
    min-height: 24px;
}

QListView::item:hover, QTreeView::item:hover, QTableView::item:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QListView::item:selected, QTreeView::item:selected, QTableView::item:selected {
    background-color: #B9F6CA;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QListView::item:selected:hover, QTreeView::item:selected:hover, QTableView::item:selected:hover {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 1px solid #00C853;
}

/* QHeaderView for tables & trees */
QHeaderView {
    background-color: #F1F8E9;
    border: none;
    border-radius: 8px;
}

QHeaderView::section {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 1px solid #C8E6C9;
    border-radius: 6px;
    padding: 6px 10px;
    font: 600 11pt "Bahnschrift SemiBold";
    margin: 1px;
}

QHeaderView::section:hover {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QHeaderView::section:checked {
    background-color: #B9F6CA;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QTableCornerButton::section {
    background-color: #DCEDC8;
    border: 1px solid #C8E6C9;
    border-radius: 6px;
}

/* Tree branches */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/asagiOk.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/yukariOk.png);
}

/* ============================================================================
 *  SCROLL BARS
 * ============================================================================ */
QScrollBar:vertical {
    background-color: #E0EEE0;
    width: 12px;
    margin: 4px 2px 4px 2px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #A5C8A5;
    min-height: 30px;
    border-radius: 5px;
    border: 1px solid #C8E6C9;
}

QScrollBar::handle:vertical:hover {
    background-color: #00C853;
    border: 1px solid #00C853;
}

QScrollBar::handle:vertical:pressed {
    background-color: #00A040;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    background-color: #E0EEE0;
    height: 12px;
    margin: 2px 4px 2px 4px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #A5C8A5;
    min-width: 30px;
    border-radius: 5px;
    border: 1px solid #C8E6C9;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00C853;
    border: 1px solid #00C853;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #00A040;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

/* ============================================================================
 *  SLIDERS & PROGRESS BAR
 * ============================================================================ */
QSlider:horizontal {
    min-height: 24px;
}

QSlider::groove:horizontal {
    background-color: #C8E6C9;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #00C853;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #00C853;
    border: 2px solid #00C853;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #69F0AE;
    border: 2px solid #00C853;
}

QSlider::handle:horizontal:pressed {
    background-color: #00A040;
}

QSlider:vertical {
    min-width: 24px;
}

QSlider::groove:vertical {
    background-color: #C8E6C9;
    width: 6px;
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background-color: #00C853;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: #00C853;
    border: 2px solid #00C853;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background-color: #69F0AE;
    border: 2px solid #00C853;
}

QSlider::handle:vertical:pressed {
    background-color: #00A040;
}

/* Progress Bar */
QProgressBar {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 10px;
    text-align: center;
    font: 600 10pt "Bahnschrift SemiBold";
    min-height: 20px;
    max-height: 24px;
}

QProgressBar:hover {
    border: 2px solid #00C853;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00A040, stop:1 #00C853);
    border-radius: 7px;
}

QProgressBar:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QProgressBar:disabled::chunk {
    background-color: #C8E6C9;
}

/* ============================================================================
 *  TAB WIDGET & TAB BAR
 * ============================================================================ */
QTabWidget {
    background-color: #F1F8E9;
    color: #1B5E20;
    font: 600 11pt "Bahnschrift SemiBold";
    border: none;
}

QTabWidget::pane {
    background-color: #F1F8E9;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    top: -2px;
}

QTabBar::tab {
    background-color: #DCEDC8;
    color: #6A9A6A;
    border: 2px solid #C8E6C9;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 18px;
    margin-right: 4px;
    font: 600 11pt "Bahnschrift SemiBold";
}

QTabBar::tab:hover {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 2px solid #00C853;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #00C853;
    border-bottom: 2px solid #F1F8E9;
}

QTabBar::tab:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

QTabBar QToolButton {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 1px solid #C8E6C9;
    border-radius: 6px;
    padding: 2px;
}

QTabBar QToolButton:hover {
    background-color: #DCEDC8;
    border: 1px solid #00C853;
}

/* ============================================================================
 *  TOOLBOX & ACCORDION
 * ============================================================================ */
QToolBox {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
    font: 600 11pt "Bahnschrift SemiBold";
}

QToolBox::tab {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 1px solid #C8E6C9;
    border-radius: 8px;
    font: 600 11pt "Bahnschrift SemiBold";
}

QToolBox::tab:hover {
    background-color: #C8E6C9;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QToolBox::tab:selected {
    background-color: #B9F6CA;
    color: #1B5E20;
    border: 1px solid #00C853;
}

/* ============================================================================
 *  MENU BAR & CONTEXT MENUS
 * ============================================================================ */
QMenuBar {
    background-color: #F1F8E9;
    color: #1B5E20;
    font: 600 11pt "Bahnschrift SemiBold";
    border-bottom: 2px solid #C8E6C9;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #DCEDC8;
    color: #1B5E20;
    border: 1px solid #00C853;
}

QMenuBar::item:pressed {
    background-color: #B9F6CA;
    color: #1B5E20;
}

QMenu {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #00C853;
    border-radius: 10px;
    padding: 6px;
    font: 600 11pt "Bahnschrift SemiBold";
}

QMenu::item {
    padding: 6px 24px 6px 20px;
    border-radius: 6px;
    border: 1px solid transparent;
    color: #1B5E20;
}

QMenu::item:selected {
    background-color: #00C853;
    color: #FFFFFF;
    border: 1px solid #00C853;
}

QMenu::item:disabled {
    color: #A5C8A5;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #C8E6C9;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 4px;
}

/* ============================================================================
 *  DOCK WIDGET & TOOLBAR
 * ============================================================================ */
QDockWidget {
    background-color: #F1F8E9;
    color: #1B5E20;
    font: 600 11pt "Bahnschrift SemiBold";
    border: 2px solid #C8E6C9;
    border-radius: 10px;
    titlebar-close-icon: url(:/icons/asagiOk.png);
}

QDockWidget:hover {
    border: 2px solid #00C853;
}

QDockWidget::title {
    background-color: #DCEDC8;
    color: #1B5E20;
    padding: 6px 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #C8E6C9;
    text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
    subcontrol-position: top right;
    top: 4px;
}

QDockWidget::close-button {
    right: 6px;
}

QDockWidget::float-button {
    right: 28px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #DCEDC8;
    border: 1px solid #00C853;
}

QToolBar {
    background-color: #F1F8E9;
    border: 1px solid #C8E6C9;
    border-radius: 8px;
    padding: 2px;
    spacing: 4px;
}

QToolBar::handle {
    background-color: #C8E6C9;
    width: 4px;
    height: 4px;
    margin: 4px;
}

QToolBar::separator {
    background-color: #C8E6C9;
    width: 1px;
    height: 1px;
    margin: 4px;
}

/* ============================================================================
 *  SPLITTER & DIAL
 * ============================================================================ */
QSplitter::handle {
    background-color: #C8E6C9;
}

QSplitter::handle:hover {
    background-color: #00C853;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QDial {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
}

QDial:hover {
    border: 2px solid #00C853;
}

QDial:focus {
    border: 2px solid #00A040;
}

QDial:disabled {
    background-color: #EEF4EE;
    color: #A5C8A5;
    border: 2px solid #D8EAD8;
}

/* ============================================================================
 *  TOOLTIP & CALENDAR
 * ============================================================================ */
QToolTip {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #00C853;
    border-radius: 8px;
    padding: 6px 10px;
    font: 600 10pt "Bahnschrift SemiBold";
    opacity: 240;
}

QCalendarWidget {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 12px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #DCEDC8;
    border-bottom: 2px solid #C8E6C9;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #1B5E20;
    font: 600 10pt "Bahnschrift SemiBold";
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #C8E6C9;
    border: 1px solid #00C853;
    color: #1B5E20;
}

QCalendarWidget QMenu {
    background-color: #F1F8E9;
    border: 2px solid #00C853;
}

QCalendarWidget QSpinBox {
    background-color: #F1F8E9;
    border: 1px solid #C8E6C9;
    border-radius: 6px;
    padding: 2px 20px 2px 4px;
}

QCalendarWidget QAbstractItemView {
    background-color: #F1F8E9;
    color: #1B5E20;
    selection-background-color: #B9F6CA;
    selection-color: #1B5E20;
    outline: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #A5C8A5;
}

/* ============================================================================
 *  RUBBER BAND & KEY SEQUENCE EDIT
 * ============================================================================ */
QRubberBand {
    background-color: #B9F6CA;
    border: 2px solid #00C853;
}

QKeySequenceEdit {
    background-color: #F1F8E9;
    color: #1B5E20;
    border: 2px solid #C8E6C9;
    border-radius: 10px;
    padding: 6px 10px;
    font: 600 11pt "Bahnschrift SemiBold";
}

QKeySequenceEdit:hover {
    border: 2px solid #00C853;
}

QKeySequenceEdit:focus {
    border: 2px solid #00A040;
}

